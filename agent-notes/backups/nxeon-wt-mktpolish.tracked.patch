new file mode 100644
index 0000000000..49bd403a4b
--- /dev/null
+++ b/app/nxm/_components/FooterColumns.tsx
@@ -0,0 +1,35 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+/**
+ * One footer link column. Desktop (>= 760px): a plain always-open list.
+ * Mobile: a native <details> accordion, collapsed. The markup is rendered
+ * `open` on the server so every link is in the HTML, crawlable and usable
+ * without JS; the effect collapses it on narrow screens only (the footer sits
+ * below the fold, so there is no visible flash and nothing above it moves).
+ */
+export function FooterColumn({ id, title, children }: { id: string; title: string; children: React.ReactNode }) {
+  const ref = useRef<HTMLDetailsElement>(null);
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const mq = window.matchMedia("(min-width: 760px)");
+    const sync = () => { el.open = mq.matches; };
+    sync();
+    mq.addEventListener("change", sync);
+    return () => mq.removeEventListener("change", sync);
+  }, []);
+  return (
+    <details className="fcol" ref={ref} open>
+      <summary
+        id={id}
+        onClick={(e) => { if (window.matchMedia("(min-width: 760px)").matches) e.preventDefault(); }}
+      >
+        <h2>{title}</h2>
+        <svg className="fcol-chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" /></svg>
+      </summary>
+      {children}
+    </details>
+  );
+}
