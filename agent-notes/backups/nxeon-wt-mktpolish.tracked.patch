@@ -0,0 +1,13 @@
+/**
+ * Asserts every link in the marketing footer config exists in the live-route
+ * manifest (app/nxm/_data/live-routes.json). Usage: npx tsx scripts/check-footer-links.ts
+ */
+import { FOOTER_COLUMNS } from "../app/nxm/_components/footer-config";
+import routes from "../app/nxm/_data/live-routes.json";
+
+const exact = new Set<string>(routes.exact);
+const patterns = routes.patterns.map((p: string) => new RegExp(p));
+const bad = FOOTER_COLUMNS.flatMap((c) => c.links).filter((l) => !exact.has(l.href) && !patterns.some((p) => p.test(l.href)));
+for (const l of bad) console.error(`dead footer link: ${l.label} -> ${l.href}`);
+console.log(`${FOOTER_COLUMNS.flatMap((c) => c.links).length} footer links checked, ${bad.length} dead`);
+process.exit(bad.length ? 1 : 0);
