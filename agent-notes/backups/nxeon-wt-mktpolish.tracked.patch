@@ -0,0 +1,91 @@
+/**
+ * Marketing-site responsive checker: loads each route at each viewport, fails on
+ * horizontal overflow, lists the offending elements, and (optionally) saves
+ * screenshots. Complements scripts/check-responsive.ts (portal).
+ *
+ *   npx tsx scripts/check-responsive-marketing.ts [--base http://localhost:3118]
+ *        [--routes /nxm,/nxm/pricing] [--widths 360,390,414,768,1024,1440]
+ *        [--shots /tmp/mkt-shots/run] [--json out.json] [--md out.md]
+ *
+ * Per route x width it reports: horizontal overflow (document wider than the
+ * viewport), up to 5 culprit elements (anything poking past the right edge that
+ * is not inside a horizontal scroller), images wider than the viewport,
+ * undersized tap targets (< 32px, inside the main content) and body text < 12px.
+ * Exit code 1 when any route overflows horizontally.
+ * Run heavy: scratchpad/heavy.sh, one browser at a time (this box is production).
+ */
+import { chromium } from "playwright";
+import fs from "node:fs";
+
+const arg = (k: string, d: string) => { const i = process.argv.indexOf(`--${k}`); return i > 0 ? process.argv[i + 1] : d; };
+const BASE = arg("base", "http://localhost:3118");
+export const DEFAULT_ROUTES = [
+  "/nxm", "/nxm/pricing", "/nxm/vps", "/nxm/web-hosting", "/nxm/business-email", "/nxm/domains", "/nxm/nxcloud",
+  "/nxm/game-servers", "/nxm/minecraft-server-hosting", "/nxm/rust-server-hosting", "/nxm/minecraft-server-hosting/singapore",
+  "/nxm/singapore-vps-hosting", "/nxm/germany-vps-hosting", "/nxm/free-minecraft", "/nxm/game-servers/directory",
+  "/nxm/mods", "/nxm/blog", "/nxm/tools", "/nxm/tools/server-size-calculator", "/nxm/tools/minecraft-server-status",
+  "/nxm/affiliate", "/nxm/about", "/nxm/contact", "/nxm/help", "/nxm/docs", "/nxm/status", "/nxm/compare",
+  "/nxm/migrate", "/nxm/features", "/nxm/security", "/nxm/developers", "/nxm/legal/terms", "/nxm/vps-vs-digitalocean",
+  "/nxm/aternos-alternative", "/login", "/register",
+];
+const ROUTES = arg("routes", DEFAULT_ROUTES.join(",")).split(",").filter(Boolean);
+const WIDTHS = arg("widths", "360,390,414,768,1024,1440").split(",").map(Number);
+const SHOTS = arg("shots", "");
+
+type Row = { route: string; width: number; status: number; overflowPx: number; culprits: string[]; wideImgs: number; smallTaps: number; tinyText: number; error?: string };
+
+async function main() {
+  const browser = await chromium.launch();
+  const rows: Row[] = [];
+  for (const route of ROUTES) {
+    for (const width of WIDTHS) {
+      const ctx = await browser.newContext({ viewport: { width, height: 800 }, isMobile: width < 700, hasTouch: width < 700, reducedMotion: "reduce" });
+      const page = await ctx.newPage();
+      await page.addInitScript("window.__name = (f) => f;"); // tsx/esbuild injects __name() into evaluate callbacks
+      const row: Row = { route, width, status: 0, overflowPx: 0, culprits: [], wideImgs: 0, smallTaps: 0, tinyText: 0 };
+      try {
+        const res = await page.goto(BASE + route, { waitUntil: "domcontentloaded", timeout: 180000 });
+        row.status = res?.status() ?? 0;
+        await page.waitForLoadState("networkidle", { timeout: 20000 }).catch(() => {});
+        await page.waitForTimeout(800);
+        // scroll through once so lazy / reveal-on-scroll content renders before measuring
+        await page.evaluate(async () => { for (let y = 0; y < document.body.scrollHeight; y += 700) { scrollTo(0, y); await new Promise((r) => setTimeout(r, 40)); } scrollTo(0, 0); });
+        await page.waitForTimeout(300);
+        const m = await page.evaluate(() => {
+          const vw = document.documentElement.clientWidth;
+          const sw = Math.max(document.documentElement.scrollWidth, document.body.scrollWidth);
+          const inScroller = (el: Element) => { for (let p = el.parentElement; p && p !== document.body; p = p.parentElement) { const o = getComputedStyle(p).overflowX; if (o === "auto" || o === "scroll" || o === "hidden" || o === "clip") return true; } return false; };
+          const culprits: string[] = [];
+          let wideImgs = 0, smallTaps = 0, tinyText = 0;
+          for (const el of Array.from(document.querySelectorAll("body *"))) {
+            const cs = getComputedStyle(el);
+            if (cs.display === "none" || cs.visibility === "hidden" || cs.position === "fixed") continue;
+            const r = el.getBoundingClientRect();
+            if (!r.width || !r.height) continue;
+            if (r.right > vw + 1 && !inScroller(el) && culprits.length < 5) culprits.push(`${el.tagName.toLowerCase()}.${String((el as HTMLElement).className || "").toString().split(/\s+/).slice(0, 3).join(".")} right=${Math.round(r.right)}`);
+            if (el.tagName === "IMG" && r.width > vw + 1 && !inScroller(el)) wideImgs++;
+            if (/^(A|BUTTON)$/.test(el.tagName) && r.height < 32 && r.width < 400 && el.closest("main,section,footer,.nxm-p,.nxm-home") && (el.textContent || "").trim().length && r.top < 1e6) smallTaps++;
+            if (el.childNodes.length && Array.from(el.childNodes).some((n) => n.nodeType === 3 && (n.textContent || "").trim().length > 3) && parseFloat(cs.fontSize) < 12) tinyText++;
+          }
+          return { over: sw - vw, culprits, wideImgs, smallTaps, tinyText };
+        });
+        row.overflowPx = Math.max(0, m.over); row.culprits = m.culprits; row.wideImgs = m.wideImgs; row.smallTaps = m.smallTaps; row.tinyText = m.tinyText;
+        if (SHOTS) { fs.mkdirSync(SHOTS, { recursive: true }); await page.screenshot({ path: `${SHOTS}/${route.replace(/\W+/g, "_") || "home"}-${width}.png`, fullPage: false }); }
+      } catch (e) { row.error = String((e as Error).message).split("\n")[0]; }
+      rows.push(row);
+      console.log(`${row.overflowPx > 0 || row.error ? "FAIL" : "ok  "} ${route} @${width}  status=${row.status} overflow=${row.overflowPx}px imgs=${row.wideImgs} taps<32=${row.smallTaps} text<12=${row.tinyText}${row.culprits.length ? "  " + row.culprits.join(" | ") : ""}${row.error ? " ERR " + row.error : ""}`);
+      await ctx.close();
+    }
+  }
+  await browser.close();
+  if (arg("json", "")) fs.writeFileSync(arg("json", ""), JSON.stringify(rows, null, 1));
+  if (arg("md", "")) {
+    const head = `| Route | ${WIDTHS.map((w) => w + "px").join(" | ")} |\n|---|${WIDTHS.map(() => "---").join("|")}|\n`;
+    const body = ROUTES.map((r) => `| \`${r}\` | ${WIDTHS.map((w) => { const x = rows.find((q) => q.route === r && q.width === w)!; return x.error ? "ERR" : x.status >= 400 ? String(x.status) : x.overflowPx > 0 ? `OVERFLOW ${x.overflowPx}px` : "ok"; }).join(" | ")} |`).join("\n");
+    fs.writeFileSync(arg("md", ""), head + body + "\n");
+  }
+  const bad = rows.filter((r) => r.overflowPx > 0 || r.error);
+  console.log(`\n${rows.length} checks, ${bad.length} failing`);
+  process.exit(bad.length ? 1 : 0);
+}
+main();
