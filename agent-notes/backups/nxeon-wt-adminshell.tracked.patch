+function greeting() {
+  const h = new Date().getUTCHours();
+  return h < 12 ? "morning" : h < 18 ? "afternoon" : "evening";
+}
+
+/** Streams in: allNodeUtil() makes live Proxmox reads that can be slow. */
+async function CapacityPanel() {
+  let data: Awaited<ReturnType<typeof allNodeUtil>> | null = null;
+  try {
+    data = await Promise.race([
+      allNodeUtil(),
+      new Promise<null>((r) => setTimeout(() => r(null), 8000)),
+    ]);
+  } catch {
+    data = null;
+  }
+  return (
+    <Panel title="Node capacity" action={{ href: "/admin/nodes", label: "Nodes" }} className="h-full">
+      {!data ? (
+        <PanelError>Capacity readings didn&apos;t arrive within 8s — node APIs may be unreachable. Full detail on Monitoring.</PanelError>
+      ) : data.nodes.filter((n) => n.enabled).length === 0 ? (
+        <EmptyRow>No enabled nodes.</EmptyRow>
+      ) : (
+        <ul className="adm-list">
+          {data.nodes
+            .filter((n) => n.enabled)
+            .map((n) => (
+              <li key={`${n.kind}:${n.id}`} className="px-5 py-3">
+                <div className="mb-2 flex items-center gap-2 text-[13px]">
+                  <span className="font-semibold" style={{ color: "var(--adm-ink)" }}>{n.name}</span>
+                  <span className="text-[11px]" style={{ color: "var(--adm-faint)" }}>{n.kind === "HOSTING" ? "web hosting" : "proxmox"}</span>
+                  <span className="ml-auto">
+                    {!n.reachable ? (
+                      <Pill tone="amber">unreachable</Pill>
+                    ) : n.severity === "OK" ? (
+                      <Pill tone="green">ok</Pill>
+                    ) : (
+                      <Pill tone={n.severity === "CRITICAL" ? "red" : "amber"}>{n.severity.toLowerCase()}</Pill>
+                    )}
+                  </span>
+                </div>
+                <div className="grid gap-1.5">
+                  {n.dims.map((d) => (
+                    <div key={d.dimension} className="grid grid-cols-[4.5rem_1fr_3rem] items-center gap-2 text-[11.5px]" title={d.detail}>
+                      <span style={{ color: "var(--adm-muted)" }}>{d.dimension.toLowerCase()}</span>
+                      <Meter pct={d.pct} warnAt={data!.thresholds.warnPct} alertAt={data!.thresholds.critPct} label={`${n.name} ${d.dimension}`} />
+                      <span className="text-right tabular-nums" style={{ color: "var(--adm-ink-2)" }}>{Math.round(d.pct)}%</span>
+                    </div>
+                  ))}
+                </div>
+              </li>
+            ))}
+        </ul>
+      )}
+    </Panel>
+  );
+}
+
+async function ActivityPanel() {
+  const recent = await db.auditLog
+    .findMany({ include: { user: { select: { email: true } } }, orderBy: { createdAt: "desc" }, take: 9 })
+    .catch(() => []);
+  // Resolve the real admin behind any row taken while impersonating, so the feed
+  // never shows a customer as the actor for something an admin did as them.
+  const actorIds = [...new Set(recent.map((a) => actingAdminId(a.detail)).filter(Boolean))] as string[];
+  const actorEmail = new Map(
+    (actorIds.length ? await db.user.findMany({ where: { id: { in: actorIds } }, select: { id: true, email: true } }) : []).map(
+      (u) => [u.id, u.email],
+    ),
+  );
+  return (
+    <Panel title="Activity" action={{ href: "/admin/audit", label: "Audit log" }}>
+      {recent.length === 0 ? (
+        <EmptyRow>No activity yet.</EmptyRow>
+      ) : (
+        <ul className="adm-list">
+          {recent.map((a) => {
+            const asAdmin = actingAdminId(a.detail);
+            return (
+              <li key={a.id} className="flex items-baseline gap-3 px-5 py-2.5 text-[13px]">
+                <div className="min-w-0 flex-1">
+                  <span className="font-medium" style={{ color: "var(--adm-ink)" }}>{a.action}</span>
+                  <span className="ml-2 truncate text-[11.5px]" style={{ color: "var(--adm-faint)" }}>
+                    {asAdmin ? (actorEmail.get(asAdmin) ?? asAdmin) : (a.user?.email ?? "system")}
+                  </span>
+                  {asAdmin && <span className="ml-2"><Pill tone="amber">as {a.user?.email ?? "customer"}</Pill></span>}
+                </div>
+                <span className="shrink-0 text-[11.5px]" style={{ color: "var(--adm-faint)" }}>{timeAgo(a.createdAt)}</span>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </Panel>
+  );
+}
