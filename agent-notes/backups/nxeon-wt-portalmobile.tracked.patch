diff --git a/app/globals.css b/app/globals.css
index 0f5e01b39a..466c15f168 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -3396,3 +3396,51 @@ html.nx-portal[data-theme="light"] body {
 @media (max-width: 640px) {
   input, select, textarea { font-size: 16px; }
 }
+
+/* ── Customer portal responsive hardening (Nexion scope only) ───────────────
+ * Everything here is scoped to `:root:has(.nx-shell-root)` so marketing, login
+ * and admin are untouched (see CLAUDE.md "Portals & design system").
+ *
+ * 1. Grid items default to `min-width:auto`, so on phones one wide child (a
+ *    table with min-w-[560px], a long hostname) forces its grid track — and the
+ *    whole column — wider than the screen; <main> then clips the overflow
+ *    (`[overflow-x:clip]`) and cards look cut off at the right edge. Zeroing the
+ *    automatic minimum lets tracks shrink to the viewport and lets the child's
+ *    own overflow-x-auto / truncate take over. Written inside @layer base with
+ *    :where() (zero specificity) so any utility class (`min-w-*`) still wins.
+ *    Below lg only, so desktop layout is byte-for-byte the same as before. */
+@layer base {
+  @media (max-width: 1023px) {
+    :where(:root:has(.nx-shell-root)) :where(main .grid) > *,
+    :where(:root:has(.nx-shell-root)) :where(main .flex) > :where(.grow, .flex-1) {
+      min-width: 0;
+    }
+  }
+}
+
+@media (max-width: 767px) {
+  /* 2. Touch targets: compact button sizes grow to 44px on phones. */
+  :root:has(.nx-shell-root) .btn-sm,
+  :root:has(.nx-shell-root) .btn-xs { height: 44px; }
+  :root:has(.nx-shell-root) .chip { height: 38px; }
+  /* 3. Long unbroken strings (hostnames, emails, IDs) wrap instead of widening the page. */
+  :root:has(.nx-shell-root) main { overflow-wrap: anywhere; }
+  :root:has(.nx-shell-root) main :is(pre, code, kbd, .mono, table) { overflow-wrap: normal; }
+}
+
+@media (max-width: 767px) {
+  /* 4. Centered modals whose panel is taller than a phone screen used to have their top and bottom
+        cut off and unreachable (`items-center` on a non-scrolling overlay). `safe center` centers
+        when it fits and falls back to top-aligned + scrollable when it doesn't. Bottom sheets
+        (`items-end`) are left alone. */
+  :root:has(.nx-shell-root) .fixed.inset-0.flex[class*="items-center"]:not([class*="items-end"]) {
+    align-items: safe center;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+  }
+  :root:has(.nx-shell-root) .fixed.inset-0.grid[class*="place-items-center"] {
+    place-items: safe center;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+  }
+}
