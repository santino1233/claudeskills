+// ---------------------------------------------------------------------------
+// Bot filtering + crawler activity + insights — one self-scheduling tick.
+// ---------------------------------------------------------------------------
+// worker/index.ts calls `analyticsInsightsTick()` once per loop WITHOUT
+// awaiting it; this function keeps its own timers and an in-flight guard, so a
+// slow DNS lookup or a big log chunk can never stall job processing, and two
+// ticks never overlap.
+
+const TICKS = {
+  crawlerLog: { every: 2 * 60_000, last: 0 },
+  botReclassify: { every: 5 * 60_000, last: 0 },
+  snapshot: { every: 60 * 60_000, last: 0 },
+  alerts: { every: 60 * 60_000, last: 0 },
+};
+let tickRunning = false;
+
+async function runIfDue(name: keyof typeof TICKS, fn: () => Promise<unknown>) {
+  const t = TICKS[name];
+  if (Date.now() - t.last < t.every) return;
+  t.last = Date.now();
+  try {
+    await fn();
+  } catch (e) {
+    console.error(`[analytics] ${name} sweep error`, e);
+  }
+}
+
+export async function analyticsInsightsTick(): Promise<void> {
+  if (tickRunning) return;
+  tickRunning = true;
+  try {
+    await runIfDue("crawlerLog", crawlerLogSweep);
+    await runIfDue("botReclassify", botReclassifySweep);
+    await runIfDue("snapshot", insightsSnapshotSweep);
+    await runIfDue("alerts", insightsAlertSweep);
+  } finally {
+    tickRunning = false;
+  }
+}
